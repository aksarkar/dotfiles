include /etc/sway/config.d/*

exec --no-startup-id dbus-update-activation-environment --all
exec wlsunset -l 43.7 -L -72.29
exec swayidle -w
exec qutebrowser
exec emacsclient -c

set $mod Mod4
font pango:Fira Code bold 12
floating_modifier $mod
workspace_layout tabbed
focus_follows_mouse no
default_border none
hide_edge_borders --i3 both

input "1:1:AT_Translated_Set_2_keyboard" {
  xkb_options "ctrl:swapcaps"
}

output eDP-1 background /usr/share/backgrounds/CarinaNebulaGerminiani.jpg fill

client.focused #839496 #839496 #002b36 #839496
client.focused_inactive #002b36 #002b36 #839496 #839496
client.unfocused #002b36 #002b36 #839496 #839496
client.urgent #dc322f #dc322f #fdf6e3 #fdf6e3

bindsym $mod+0 workspace 10
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+Shift+0 move container to workspace 10
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+Return exec alacritty
bindsym $mod+Shift+c kill
bindsym $mod+Shift+h move down
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move right
bindsym $mod+Shift+l move up
bindsym $mod+Shift+q exec swaymsg exit
bindsym $mod+e move workspace to output right
bindsym $mod+h focus down
bindsym $mod+j focus left
bindsym $mod+k focus right
bindsym $mod+l focus up
bindsym $mod+p exec wmenu-run -f 'Fira Code 13' -N 002b36 -n 93a1a1 -S 073642 -s 93a1a1
bindsym $mod+t focus mode_toggle
bindsym $mod+q reload
bindsym $mod+space focus mode_toggle
bindsym $mod+u exec alacritty -e ssh asarkar-singlecell
bindsym $mod+w move workspace to output left
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-
bindsym XF86MonBrightnessUp exec brightnessctl set 10%+

for_window [class="zoom"] floating enable
for_window [app_id="mpv"] floating enable
for_window [class="Pinentry-gtk"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_role="dialog"] floating enable

seat * hide_cursor 3000
